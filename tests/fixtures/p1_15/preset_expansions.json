 "expansions": {
  "cells_apart": {
   "applies_to": {
    "family": [
     "hsn"
    ]
   },
   "cases": [
    {
     "label": "apart",
     "when": {
      "all": [
       {
        "metric": "trained:rank_pr/answer",
        "op": ">=",
        "value": 2.0
       },
       {
        "metric": "trained:diversity_live/answer",
        "op": ">=",
        "value": 0.2
       }
      ]
     }
    }
   ],
   "default": "not apart"
  },
  "memory_open": {
   "applies_to": {
    "family": [
     "hsn"
    ]
   },
   "cases": [
    {
     "label": "open",
     "when": {
      "all": [
       {
        "agg": "all",
        "metric": "diag:gate/p50",
        "op": ">=",
        "steps": {
         "every": 500,
         "from": 500
        },
        "value": 0.01
       },
       {
        "agg": "all",
        "metric": "diag:grad_share/cell",
        "op": ">=",
        "steps": {
         "every": 500,
         "from": 500
        },
        "value": 0.01
       }
      ]
     }
    }
   ],
   "default": "shut"
  },
  "memory_open_queue9": {
   "applies_to": {
    "family": [
     "hsn"
    ]
   },
