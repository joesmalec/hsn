        "op": ">=",
        "steps": {
         "from": 350,
         "to": 450
        },
        "value": 0.01
       },
       {
        "agg": "median",
        "metric": "diag:grad_share/cell",
        "min_samples": 3,
        "op": ">=",
        "steps": {
         "from": 350,
         "to": 450
        },
        "value": 0.01
       },
       {
        "agg": "median",
        "metric": "diag:gate/p50",
        "min_samples": 3,
        "op": ">=",
        "steps": {
         "from": 450,
         "to": 550
        },
        "value": 0.01
       },
       {
        "agg": "median",
        "metric": "diag:grad_share/cell",
        "min_samples": 3,
        "op": ">=",
        "steps": {
         "from": 450,
         "to": 550
        },
        "value": 0.01
       },
       {
        "agg": "median",
        "metric": "diag:gate/p50",
        "min_samples": 3,
        "op": ">=",
        "steps": {
         "from": 550,
         "to": 650
        },
        "value": 0.01
       },
       {
        "agg": "median",
        "metric": "diag:grad_share/cell",
        "min_samples": 3,
        "op": ">=",
        "steps": {
         "from": 550,
         "to": 650
        },
        "value": 0.01
       }
      ]
     }
    }
   ],
   "default": "shut"
  },
  "reads_state": {
   "cases": [
    {
     "label": "no correct answers to probe",
     "when": {
      "metric": "probe:correct_n",
      "op": "==",
      "value": 0.0
     }
    },
    {
     "label": "reads state",
     "when": {
      "all": [
       {
        "metric": "probe:correct_follow_frac",
        "op": ">=",
        "value": 0.5
       },
       {
        "metric": "probe:correct_unchanged_frac",
        "op": "<=",
        "value": 0.1
       }
      ]
     }
    },
    {
     "label": "does not read state",
     "when": {
      "metric": "probe:correct_follow_frac",
      "op": "<",
      "value": 0.2
     }
    }
   ],
   "default": "partial"
  },
