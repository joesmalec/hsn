       {
        "agg": "all",
        "metric": "diag:gate/p50",
        "op": ">=",
        "steps": {
         "every": 500,
         "from": 500,
         "to": 3000
        },
        "value": 0.01
       },
       {
        "agg": "all",
        "metric": "diag:grad_share/cell",
        "op": ">=",
        "steps": {
         "every": 500,
         "from": 500,
         "to": 3000
        },
        "value": 0.01
       }
      ]
     }
    }
   ],
   "default": "shut"
  },
  "memory_open_windowed": {
